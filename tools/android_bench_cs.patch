     private static ViewerOptions StartLevel(int level) => new(level > 0 ? level : DefaultLevel, null, null, 0f, SoundMode.On);
 }
+
+/// <summary>Bench: a writer that copies each line to logcat (tag MDK).</summary>
+internal sealed partial class Logcat(TextWriter inner) : TextWriter
+{
+    private const int Info = 4;
+    private readonly System.Text.StringBuilder _line = new();
+
+    public override System.Text.Encoding Encoding => inner.Encoding;
+
+    public override void Write(char value)
+    {
+        inner.Write(value);
+        lock (_line)
+        {
+            if (value == '\r')
+            {
+                return;
+            }
+
+            if (value != '\n')
+            {
+                _line.Append(value);
+                return;
+            }
+
+            Write(Info, "MDK", _line.ToString());
+            _line.Clear();
+        }
+    }
+
+    [System.Runtime.InteropServices.LibraryImport("log", EntryPoint = "__android_log_write", StringMarshalling = System.Runtime.InteropServices.StringMarshalling.Utf8)]
+    private static partial int Write(int priority, string tag, string text);
+}
