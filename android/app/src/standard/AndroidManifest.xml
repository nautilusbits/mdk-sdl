<?xml version="1.0" encoding="utf-8"?>
<!-- Reading the MDK folder in place: All files access from Android 11, the storage permission
     before (Android 10 also needs requestLegacyExternalStorage, in the main manifest). A store
     build (-PstoreBuild=true) leaves them out and always copies. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
