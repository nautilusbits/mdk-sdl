<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mdk.Android</RootNamespace>
    <!-- libMdk.so: GameActivity.java's getLibraries. -->
    <AssemblyName>Mdk</AssemblyName>
    <ApplicationId>io.github.nemo22.mdk</ApplicationId>
    <ApplicationTitle>MDK</ApplicationTitle>
    <ApplicationVersion>20</ApplicationVersion>
    <ApplicationDisplayVersion>1.2.6</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- NativeAOT: all code compiled ahead of time with RyuJIT, as on the desktop. Links with the
         NDK r27 (AndroidNdkDirectory; r30 fails). XA1040: experimental on Android in .NET 10. -->
    <PublishAot>true</PublishAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);XA1040</NoWarn>
  </PropertyGroup>
  <!-- A store build (-p:StoreBuild=true): no All files access in the manifest (stores reject
       it for a game); the game files are always copied into the app (DataSetup). -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop projects take the program's runtime (SDL3 next to the executable); the APK
         gets SDL3 from the package's Android flavour, so they build without one
         (all three: transitive references would pass it on). -->
    <ProjectReference Include="..\Mdk.Game\Mdk.Game.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Mdk.Engine\Mdk.Engine.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Mdk.Formats\Mdk.Formats.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- SDL's activity in Java: a C# subclass of the SDL binding needs Reflection.Emit. -->
    <AndroidJavaSource Remove="@(AndroidJavaSource)" />
    <AndroidJavaSource Include="Java\GameActivity.java" Bind="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The launcher icon (tools/gen_icon.py). -->
    <AndroidResource Include="..\..\assets\icon.png" Link="Resources\drawable\icon.png" />
  </ItemGroup>
  <!-- The multi-RID publish's outer build has no native binary of its own (each RID's libMdk.so is
       in the APK already): ILCompiler's copy of it would fail. -->
  <Target Name="SkipOuterNativeCopy" BeforeTargets="CopyNativeBinary" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <NativeBinary />
    </PropertyGroup>
  </Target>
</Project>
