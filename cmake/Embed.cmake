# Generates a C++ source holding files as byte arrays, looked up by name:
#   Mdk::Embedded::Find("shaders/palette.vs.spv") -> std::span<const uint8_t>
# Usage: cmake -DOUT=<file.cpp> -DNAMES="a;b" -DFILES="pathA;pathB" -P Embed.cmake
set(body "")
set(table "")
set(i 0)
list(LENGTH FILES count)
foreach(name file IN ZIP_LISTS NAMES FILES)
  file(READ "${file}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "static const unsigned char d${i}[] = {${hex}0};\n")
  string(APPEND table "    {\"${name}\", d${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/Embed.cmake.\n#include \"Mdk.Core/Embedded.h\"\n#include <cstring>\n\n${body}
namespace { struct Entry { const char* Name; const unsigned char* Data; size_t Size; };
const Entry Entries[] = {\n${table}    {nullptr, nullptr, 0}}; }

std::span<const uint8_t> Mdk::Embedded::Find(std::string_view name)
{
    for (const Entry* e = Entries; e->Name != nullptr; e++)
    {
        if (name == e->Name)
        {
            return {e->Data, e->Size};
        }
    }

    return {};
}
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
